# Dependencies
# backend/node_modules is intentionally committed (not ignored) - same reason
# as dist/: production runs the backend as a live Node process and needs
# these at runtime, and `npm install` has been a point of failure there.
# Verified no native-compiled (.node) binaries in backend's tree before this
# decision. frontend/node_modules stays ignored: the frontend ships as a
# pre-built dist/ served statically, needs no Node process in production at
# all, and its tree *does* contain platform-specific native binaries
# (Rollup) that would carry real cross-machine risk for zero benefit.
/node_modules/
frontend/node_modules/
/.pnp
.pnp.js

# Testing
/coverage

# dist/ is intentionally committed (not ignored) - production deploys via
# `git pull` alone with no separate build step, since that build step has
# repeatedly failed/been skipped on that server. Rebuild and commit dist/
# whenever source changes; a stale committed dist/ is just as broken as a
# missing one.
build/

# Environment
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Secrets / credentials — never commit plaintext credentials
LOGIN_CREDENTIALS.md
*credentials*.md
*CREDENTIALS*.md

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Editor
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# OS
.DS_Store
Thumbs.db

# Database
*.db
*.sqlite
postgres_data/

# Misc
.cache
.eslintcache

# Runtime request traces (written by middleware/tracing.ts)
backend/traces/

# Database dumps - contain password hashes and business data, never commit
backend/backup_*.sql
backup_*.sql

# Jest coverage output
backend/coverage/
